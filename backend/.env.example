# Пример переменных окружения backend.
# Скопируйте в .env и подставьте реальные значения. .env НЕ коммитим.

# --- LLM (OpenAI-совместимый API) ---

# Ключ LLM. Для DeepSeek — ключ из https://platform.deepseek.com
# (старое имя OPENAI_API_KEY тоже поддерживается как fallback)
LLM_API_KEY=sk-...

# Базовый URL провайдера:
#   DeepSeek: https://api.deepseek.com
#   OpenAI:   https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com

# Модель:
#   DeepSeek: deepseek-chat (V3; json_object поддерживается)
#             deepseek-reasoner (R1; json_object НЕ поддерживается)
#   OpenAI:   gpt-4o-mini
LLM_MODEL=deepseek-chat

# Таймаут запроса к LLM, мс. DeepSeek бывает медленнее — 60000.
LLM_TIMEOUT_MS=60000

# --- Сервер ---

# Порт сервера
PORT=3001

# Разрешённый origin для CORS
# dev: http://localhost:5173
# prod: https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173
