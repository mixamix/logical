# Пример переменных окружения frontend.
# Скопируйте в .env.local (для dev) — файл НЕ коммитится.
#
# В dev можно оставить пустым: работает прокси Vite (/api → :3001).
# В prod на Vercel задайте VITE_API_BASE_URL = URL бэкенда на Render.

# Пример для production:
# VITE_API_BASE_URL=https://logic-backend.onrender.com
