# --- Зависимости ---
node_modules/

# --- Сборки ---
dist/
build/

# --- TypeScript артефакты инкрементальной сборки ---
*.tsbuildinfo

# --- Сгенерированные конфиги (tsc -b из tsconfig.node.json) ---
