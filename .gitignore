frontend/vite.config.d.ts

# --- Переменные окружения (секреты!) ---
.env
.env.local
.env.*.local

# --- Логи ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Кэши инструментов ---
.vite/
.cache/

# --- ОС и редакторы ---
.DS_Store
Thumbs.db
.idea/
*.swp
